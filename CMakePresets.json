{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base-vcpkg",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 Release（系统包）",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x64-vcpkg",
      "displayName": "Linux x64 Release（vcpkg）",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "MODELS_DOWNLOAD_URL": "https://github.com/Iucl-del/ArknightsAssistant/releases/download/v1.0-models/models.tar.gz"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64-vcpkg",
      "displayName": "Linux arm64 Release（vcpkg）",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "MODELS_DOWNLOAD_URL": "https://github.com/Iucl-del/ArknightsAssistant/releases/download/v1.0-models/models.tar.gz"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x64-vcpkg",
      "displayName": "Windows x64 Release（vcpkg）",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "MODELS_DOWNLOAD_URL": "https://github.com/Iucl-del/ArknightsAssistant/releases/download/v1.0-models/models.tar.gz"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-vcpkg-debug",
      "displayName": "Windows x64 Debug（vcpkg）",
      "inherits": "windows-x64-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-vcpkg",
      "displayName": "macOS Release（vcpkg）",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "MODELS_DOWNLOAD_URL": "https://github.com/Iucl-del/ArknightsAssistant/releases/download/v1.0-models/models.tar.gz"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-x64-cuda",
      "displayName": "Linux x64 Release + CUDA（vcpkg）",
      "inherits": "linux-x64-vcpkg",
      "cacheVariables": {
        "ORT_WITH_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64",               "configurePreset": "linux-x64" },
    { "name": "linux-x64-vcpkg",         "configurePreset": "linux-x64-vcpkg" },
    { "name": "linux-arm64-vcpkg",       "configurePreset": "linux-arm64-vcpkg" },
    { "name": "windows-x64-vcpkg",       "configurePreset": "windows-x64-vcpkg" },
    { "name": "windows-x64-vcpkg-debug", "configurePreset": "windows-x64-vcpkg-debug" },
    { "name": "macos-vcpkg",             "configurePreset": "macos-vcpkg" },
    { "name": "linux-x64-cuda",          "configurePreset": "linux-x64-cuda" }
  ],
  "packagePresets": [
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "generators": ["TGZ"]
    },
    {
      "name": "linux-x64-vcpkg",
      "configurePreset": "linux-x64-vcpkg",
      "generators": ["TGZ", "DEB"]
    },
    {
      "name": "linux-arm64-vcpkg",
      "configurePreset": "linux-arm64-vcpkg",
      "generators": ["TGZ", "DEB"]
    },
    {
      "name": "windows-x64-vcpkg",
      "configurePreset": "windows-x64-vcpkg",
      "generators": ["ZIP"]
    },
    {
      "name": "macos-vcpkg",
      "configurePreset": "macos-vcpkg",
      "generators": ["TGZ"]
    }
  ]
}